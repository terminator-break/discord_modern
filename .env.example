# ─── Токен Discord-бота (обязательно) ───────────────────────────────────────
# Получить: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=ваш_токен_здесь

# ─── ID гильдии (рекомендуется для разработки) ──────────────────────────────
# Если задан — команды синхронизируются мгновенно только для этого сервера.
# Если не задан — глобальная синхронизация (до 1 часа).
GUILD_ID=

# ─── Префикс для обычных команд ─────────────────────────────────────────────
PREFIX=!

# ─── Порог предупреждений для автобана ──────────────────────────────────────
WARN_THRESHOLD=3

# ─── Начальный баланс новых игроков ─────────────────────────────────────────
STARTING_BALANCE=100

# ─── Ежедневный бонус монет ─────────────────────────────────────────────────
DAILY_REWARD=100

# ─── Путь к файлу базы данных SQLite ────────────────────────────────────────
DB_PATH=bot.db
